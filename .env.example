# 复制本文件为 .env 并填写你自己的值（.env 已被 .gitignore 排除）
# Taro 约定：客户端代码中以 process.env.TARO_APP_XXX 读取，构建时注入（双端生效）

# 腾讯云 CloudBase 环境 ID（https://console.cloud.tencent.com/tcb 创建）
TARO_APP_CLOUDBASE_ENV=your-cloudbase-env-id

# CloudBase「匿名登录」Publishable Key（环境设置 → 登录授权 → 匿名登录，设计上可暴露在前端）
TARO_APP_TCB_ACCESS_KEY=your-publishable-key
